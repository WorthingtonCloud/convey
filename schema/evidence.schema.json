{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "convey.evidence/1",
 "title": "Claim ledger: every material assertion, where it came from, and how sure we are",
 "type": "object",
 "required": ["schema", "claims"],
 "additionalProperties": false,
 "$defs": {
  "number": {"type": "object", "required": ["value"], "additionalProperties": false,
   "properties": {"value": {"type": "number"}, "unit": {"type": "string"}, "label": {"type": "string"}}},
  "claim": {
   "type": "object",
   "required": ["id", "kind", "statement", "confidence"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*-[0-9]+$"},
    "kind": {"enum": ["observed", "derived", "estimated", "inferred", "hypothesis", "proposed"]},
    "statement": {"type": "string", "minLength": 1},
    "numbers": {"type": "array", "items": {"$ref": "#/$defs/number"},
     "description": "every figure a slide may show on the strength of this claim"},
    "source": {"type": "object", "required": ["file", "locator"], "additionalProperties": false,
     "properties": {"file": {"type": "string"}, "locator": {"type": "string"}, "quote": {"type": "string"}}},
    "inputs": {"type": "array", "items": {"type": "string"}, "description": "derived: the claims it is computed from"},
    "method": {"type": "string", "description": "derived or estimated: the formula or reasoning"},
    "script": {"type": "string", "description": "derived: analysis/<file>.py that prints {claim id: [numbers]} as JSON"},
    "confidence": {"type": "object", "required": ["level", "reason"], "additionalProperties": false,
     "properties": {"level": {"enum": ["high", "medium", "low"]}, "reason": {"type": "string"}}},
    "limitations": {"type": "string"},
    "relevance": {"type": "string"}
   }
  }
 },
 "properties": {
  "schema": {"enum": ["convey.evidence/1"]},
  "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
  "gaps": {"type": "array", "items": {"type": "object", "required": ["id", "text", "could_reverse"], "additionalProperties": false,
   "properties": {"id": {"type": "string"}, "text": {"type": "string"}, "could_reverse": {"type": "boolean"}}}},
  "contradictions": {"type": "array", "items": {"type": "object", "required": ["claims", "text"], "additionalProperties": false,
   "properties": {"claims": {"type": "array", "items": {"type": "string"}}, "text": {"type": "string"}}}},
  "not_supplied": {"type": "array", "items": {"type": "string"}, "description": "facts the deck must not invent"}
 }
}
